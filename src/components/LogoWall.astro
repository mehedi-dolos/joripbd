---
interface Client { id: string; name: string; logo: string; confirmed?: boolean }
interface Props { clients: Client[]; cols?: string }
const { clients, cols = 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6' } = Astro.props;
---
<ul class={`grid gap-3 ${cols}`}>
  {clients.map((c) => (
    <li class="logo-tile h-[75px]" title={c.name}>
      <img src={c.logo} alt={c.name} loading="lazy" width="230" height="117" />
      {c.confirmed === false && <span class="sr-only">(to be confirmed)</span>}
    </li>
  ))}
</ul>
