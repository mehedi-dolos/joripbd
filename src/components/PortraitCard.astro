---
/* Large portrait card for owners and advisers. Falls back to the brand
   silhouette placeholder in the card's tone when no photograph exists. */
interface Props { name: string; role: string; line?: string; photo?: string; tone?: 'wine' | 'slate' | 'navy'; placeholder?: boolean; note?: string; light?: boolean }
const { name, role, line, photo, tone = 'slate', placeholder = false, note, light = true } = Astro.props;
const src = photo ?? `/images/portrait-${tone}.jpg`;
const bg = { wine: 'bg-wine', slate: 'bg-slate', navy: 'bg-navy' }[tone];
---
<article class={`folder mt-4 overflow-hidden text-white ${bg}`}>
  <div class="hatch pointer-events-none absolute inset-0 rounded-[0_12px_12px_12px] opacity-70"></div>
  <img src={src} alt={photo ? name : ''} width="1200" height="1500" loading="lazy" class="relative block aspect-[4/5] w-full object-cover" />
  <div class="relative p-6">
    <h3 class="font-display text-[20.5px] font-bold leading-[1.05] tracking-[-0.025em]">{name}</h3>
    <p class="mt-1.5 label-mono text-white/65">{placeholder ? 'Profile to follow' : role}</p>
    {line && <p class="mt-3 text-[12.5px] leading-[1.55] text-white/85">{line}</p>}
    {note && <p class="mt-3 label-mono text-white/55">{note}</p>}
  </div>
</article>
