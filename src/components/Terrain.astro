---
/* Survey terrain: two hatched ridges (JOP navy behind, JOP brown in front) with a
   levelling traverse drawn across the front ridge.

   The strip is drawn 7680 units wide and set to `slice` anchored bottom-centre.
   With a strip that wide the SVG is always scaled to fit its HEIGHT, and only
   the sides are cropped. So the ridges keep the same shape and height on a
   laptop and on a 4K monitor; wider screens simply show more of the range.
   (A 1440-wide strip scaled to fit the width on screens over ~2000px, which
   cropped the peaks off and turned the strip into a solid band that rose
   behind the hero text.) Ridges are generated from a fixed seed, so every
   build draws the same terrain and there is no visible repeat. */
interface Props { id?: string; height?: number; class?: string; traverse?: boolean }
const { id = 't', height = 220, class: cls = '', traverse = true } = Astro.props;

const VBW = 7680, VBH = 260;

function rng(seed: number) {
  let s = seed >>> 0;
  return () => { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; };
}
function ridge(seed: number, step: [number, number], peak: [number, number], valley: [number, number]) {
  const r = rng(seed);
  const pts: [number, number][] = [];
  let x = 0, up = false;
  while (x < VBW) {
    const [lo, hi] = up ? peak : valley;
    pts.push([Math.round(x), Math.round(lo + r() * (hi - lo))]);
    x += step[0] + r() * (step[1] - step[0]);
    up = !up;
  }
  const [lo, hi] = up ? peak : valley;
  pts.push([VBW, Math.round(lo + r() * (hi - lo))]);
  return pts;
}
// Steps are about 1.4x the original 1440 artwork because the strip now renders
// at roughly 0.7x (fitted to a 170-190px tall strip), which keeps the on-screen
// peak spacing the same as before.
const back = ridge(7, [168, 236], [70, 128], [128, 168]);
const front = ridge(31, [182, 250], [140, 182], [188, 214]);
const close = (p: [number, number][]) => p.map(([x, y]) => `${x},${y}`).join(' ') + ` ${VBW},${VBH} 0,${VBH}`;

// benchmarks: every other peak of the front ridge, about 300 units apart
const peaks = front.filter((_, i) => i % 2 === 1);
const marks = peaks.filter((_, i) => i % 2 === 0);
---
<svg class={`block w-full ${cls}`} style={`height:${height}px`} viewBox={`0 0 ${VBW} ${VBH}`} preserveAspectRatio="xMidYMax slice" aria-hidden="true">
  <defs>
    <pattern id={`${id}-h`} patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(255,255,255,0.13)" stroke-width="1.6" />
    </pattern>
    <pattern id={`${id}-hd`} patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="6" stroke="rgba(0,0,0,0.16)" stroke-width="1.6" />
    </pattern>
  </defs>
  <!-- back ridge: JOP navy -->
  <polygon points={close(back)} fill="#3D506D" />
  <polygon points={close(back)} fill={`url(#${id}-h)`} />
  <!-- front ridge: JOP brown -->
  <polygon points={close(front)} fill="#A67970" />
  <polygon points={close(front)} fill={`url(#${id}-hd)`} />
  {traverse && (
    <g stroke="rgba(255,255,255,0.55)" stroke-width="1" fill="none">
      <polyline points={marks.map(([x, y]) => `${x},${y}`).join(' ')} stroke-dasharray="4 5" />
      {marks.map(([x, y]) => (
        <g>
          <circle cx={x} cy={y} r="4" fill="#292221" stroke="rgba(255,255,255,0.8)" />
          <line x1={x} y1={y + 4} x2={x} y2={y + 16} stroke="rgba(255,255,255,0.35)" />
        </g>
      ))}
    </g>
  )}
</svg>
