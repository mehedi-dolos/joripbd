---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services', menu: true },
  { href: '/clients/', label: 'Clients' },
  { href: '/management/', label: 'Management' },
  { href: '/team/', label: 'Team' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---
<header class="pointer-events-none fixed inset-x-0 top-0 z-40 px-3 pt-3 text-white md:px-5 md:pt-4">
  <div class="glass pointer-events-auto mx-auto flex h-[60px] max-w-[1080px] items-center justify-between gap-6 px-5 md:px-6">
    <div class="relative"><Logo /></div>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {nav.map((n) => n.menu ? (
        <div class="group relative">
          <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} aria-haspopup="true"
             class={`roll inline-flex items-center gap-1.5 py-2 text-[13px] font-medium tracking-[-0.015em] ${isActive(n.href) ? 'is-active' : ''}`}>
            <span class="roll-wrap"><span class="roll-a">{n.label}</span><span class="roll-b" aria-hidden="true">{n.label}</span></span>
            <Icon name="chevron" size={12} class="transition-transform duration-300 group-hover:rotate-180 group-focus-within:rotate-180" />
          </a>
          <div class="menu absolute left-0 top-full z-50 w-[248px] pt-3 lg:left-1/2 lg:-translate-x-1/2">
            <ul class="glass-panel menu-panel py-2">
              {services.map((s) => (
                <li>
                  <a href={`/services/${s.id}/`} class="menu-item roll flex items-center justify-between px-5 py-2.5 text-[14px] font-medium tracking-[-0.01em]">
                    <span class="roll-wrap"><span class="roll-a">{s.data.title}</span><span class="roll-b" aria-hidden="true">{s.data.title}</span></span>
                    <Icon name="arrow-right" size={13} class="menu-arrow opacity-0 transition-opacity" />
                  </a>
                </li>
              ))}
              <li class="mx-5 mt-2 border-t border-white/15 pt-2">
                <a href="/services/" class="menu-item roll flex items-center justify-between py-2.5 label-mono">
                  <span class="roll-wrap"><span class="roll-a">All services</span><span class="roll-b" aria-hidden="true">All services</span></span>
                  <Icon name="arrow-right" size={13} class="menu-arrow opacity-0 transition-opacity" />
                </a>
              </li>
            </ul>
          </div>
        </div>
      ) : (
        <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
           class={`roll py-2 text-[13px] font-medium tracking-[-0.015em] ${isActive(n.href) ? 'is-active' : ''}`}>
          <span class="roll-wrap"><span class="roll-a">{n.label}</span><span class="roll-b" aria-hidden="true">{n.label}</span></span>
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href="/contact/" class="btn-wine roll hidden sm:inline-flex"><span class="roll-wrap"><span class="roll-a">Request a service</span><span class="roll-b roll-b-light" aria-hidden="true">Request a service</span></span></a>
      <button id="nav-toggle" type="button" class="inline-flex h-11 w-11 items-center justify-center border border-white/20 text-white md:hidden" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <Icon name="menu" size={17} class="icon-menu" />
        <Icon name="x" size={17} class="icon-close hidden" />
      </button>
    </div>
  </div>
  <div id="mobile-nav" hidden class="glass pointer-events-auto mx-auto mt-2 max-w-[1080px] md:hidden">
    <nav class="flex flex-col px-5 py-2" aria-label="Mobile">
      {nav.map((n) => (
        <div class="border-b border-white/10">
          <a href={n.href} class={`block py-3.5 font-display text-[20.5px] font-bold tracking-[-0.02em] ${isActive(n.href) ? 'text-white' : 'text-white/70'}`}>{n.label}</a>
          {n.menu && (
            <ul class="-mt-1 mb-3 grid gap-1 pl-4">
              {services.map((s) => <li><a href={`/services/${s.id}/`} class="block py-1.5 text-[13px] text-white/65">{s.data.title}</a></li>)}
            </ul>
          )}
        </div>
      ))}
      <a href="/contact/" class="btn-wine my-4">Request a service</a>
    </nav>
  </div>
</header>

<style>
  /* Monochrome text that rolls up into wine on hover */
  .roll { color: rgba(255,255,255,0.78); }
  .roll.is-active { color: #fff; }
  .roll-wrap { position: relative; display: inline-block; overflow: hidden; vertical-align: top; }
  .roll-a, .roll-b { display: block; transition: transform .45s cubic-bezier(.76,0,.24,1); }
  .roll-b { position: absolute; left: 0; top: 100%; color: #fff; }
  .roll-b-light { color: #fff; }
  .roll:hover .roll-a, .roll:focus-visible .roll-a, .menu-item:hover .roll-a { transform: translateY(-100%); }
  .roll:hover .roll-b, .roll:focus-visible .roll-b, .menu-item:hover .roll-b { transform: translateY(-100%); }
  .roll.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; background: #fff; }
  .roll.is-active { position: relative; }
  .btn-wine.roll { color: #fff; }
  .btn-wine.roll:hover { background: #6E2039; }
  /* The bar's blur sits on a pseudo-element. If it sat on the bar itself the
     bar would become the backdrop root for the dropdown, which could then
     only blur the bar, not the page. */
  .glass { position: relative; }
  .glass > * { position: relative; }
  .glass::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(90,111,138,0.42), rgba(65,84,105,0.38));
    -webkit-backdrop-filter: blur(24px) saturate(170%);
    backdrop-filter: blur(24px) saturate(170%);
    border: 1px solid rgba(220,227,232,0.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), inset 0 -1px 0 rgba(0,0,0,0.18), 0 18px 50px rgba(0,0,0,0.32);
  }
  .glass::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,0.10), rgba(255,255,255,0) 50%); }
  /* Dropdown panel animates itself, so its blur is never trapped behind a fading wrapper */
  .menu-panel { visibility: hidden; opacity: 0; transform: translateY(8px); transition: opacity .3s ease, transform .3s ease, visibility 0s linear .3s; }
  .group:hover .menu-panel, .group:focus-within .menu-panel { visibility: visible; opacity: 1; transform: none; transition: opacity .3s ease, transform .3s ease, visibility 0s; }
  .menu::before { visibility: hidden; opacity: 0; transition: opacity .3s ease, visibility 0s linear .3s; }
  .group:hover .menu::before, .group:focus-within .menu::before { visibility: visible; opacity: 1; transition: opacity .3s ease, visibility 0s; }
  .glass-panel {
    background: linear-gradient(180deg, rgba(90,111,138,0.46), rgba(65,84,105,0.44));
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgba(220,227,232,0.22);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.18), 0 30px 80px rgba(0,0,0,0.45);
  }
  .menu-item { color: rgba(255,255,255,0.82); }
  .menu-item:hover { color: #fff; }
  .menu-item:hover .menu-arrow { opacity: 1; }
  .menu::before { content: ""; position: absolute; left: 32px; top: 1px; width: 12px; height: 12px; background: rgba(90,111,138,0.7); border-left: 1px solid rgba(220,227,232,.22); border-top: 1px solid rgba(220,227,232,.22); transform: translateX(-50%) rotate(45deg); }
  @media (min-width: 1024px) { .menu::before { left: 50%; } }
  @media (prefers-reduced-motion: reduce) { .roll-a, .roll-b { transition: none; } }
</style>

<script>
  const btn = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    if (!panel) return;
    const open = panel.hidden;
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.icon-menu')?.classList.toggle('hidden', open);
    btn.querySelector('.icon-close')?.classList.toggle('hidden', !open);
  });
</script>
