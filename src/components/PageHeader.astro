---
import Terrain from './Terrain.astro';
interface Props { eyebrow?: string; title: string; intro?: string; image?: { src: string; alt: string }; terrain?: boolean }
const { eyebrow, title, intro, image, terrain = true } = Astro.props;
---
<section class="grain hero-under bg-charcoal text-white">
  {image ? (
    <div class="container-site grid items-end gap-10 pt-14 md:grid-cols-12 md:gap-12 md:pt-24">
      <div class="pb-2 md:col-span-7 md:pb-24">
        {eyebrow && <p class="label-mono-light">{eyebrow}</p>}
        <h1 class="display-1 mt-5 max-w-[16ch] text-white">{title}</h1>
        {intro && <p class="mt-7 max-w-[54ch] text-[14.5px] leading-[1.65] tracking-[-0.005em] text-white/70 md:text-[15.5px]">{intro}</p>}
        <slot />
      </div>
      <div class="relative z-10 md:col-span-5">
        <figure class="folder mt-4 overflow-hidden bg-charcoal-3 shadow-[0_24px_60px_rgba(0,0,0,0.45)]">
          <img src={image.src} alt={image.alt} width="1200" height="900" class="block aspect-[4/3] w-full object-cover" fetchpriority="high" />
        </figure>
      </div>
    </div>
  ) : (
    <div class="container-site pt-16 pb-12 text-center md:pt-24 md:pb-16">
      {eyebrow && <p class="label-mono-light">{eyebrow}</p>}
      <h1 class="display-1 mx-auto mt-5 max-w-[18ch] text-white">{title}</h1>
      {intro && <p class="mx-auto mt-7 max-w-[58ch] text-[14.5px] leading-[1.65] tracking-[-0.005em] text-white/70 md:text-[15.5px]">{intro}</p>}
      <slot />
    </div>
  )}
  {terrain && <Terrain id="ph" height={image ? 187 : 128} traverse={false} class={image ? 'relative z-0 -mt-24 md:-mt-32' : ''} />}
</section>
