---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import RequestForm from '../components/RequestForm.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
const management = (await getCollection('people')).filter((p) => p.data.group === 'management' && p.data.phone).sort((a, b) => a.data.order - b.data.order);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;
---
<Base title="Contact" description="Contact Jorip O Paridarshan Company Limited at Paltan Tower, Dhaka. Request a valuation, survey, loss assessment or insurance adjustment.">
  <PageHeader eyebrow="Contact" title="Appoint us, or ask a question." image={{ src: '/images/hero-contact.jpg', alt: 'A rotary telephone, an envelope, a street map with a pin and an office entrance' }} intro="Send the appointment letter or describe the property or claim. We confirm the surveyor and the visit date within one working day." />

  <section class="dotgrid bg-paper">
    <div class="container-site grid gap-10 py-16 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7">
        <div class="folder mt-4 bg-white p-7 md:p-9">
          <h2 class="display-3 text-charcoal">Request for service</h2>
          <div class="mt-7"><RequestForm /></div>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="folder hatch mt-4 bg-slate-2 p-7 text-white">
          <h2 class="label-mono text-white/60">Corporate office</h2>
          <address class="mt-4 space-y-3 text-[13px] not-italic text-white/85">
            <p class="flex gap-3"><Icon name="map-pin" size={15} class="mt-0.5 shrink-0 text-white/60" /><span>{site.address.line1}<br />{site.address.line2}<br />{site.address.city}, {site.address.country}</span></p>
            <p class="flex gap-3"><Icon name="phone" size={15} class="mt-0.5 shrink-0 text-white/60" /><a href={site.phoneHref} class="font-mono tnum hover:text-white">{site.phone}</a></p>
            <p class="flex gap-3"><Icon name="mail" size={15} class="mt-0.5 shrink-0 text-white/60" /><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></p>
            <p class="flex gap-3"><Icon name="clock" size={15} class="mt-0.5 shrink-0 text-white/60" /><span>{site.hours}</span></p>
          </address>
        </div>

        <div class="mt-5 rounded-[12px] bg-white/70 p-7">
          <h2 class="label-mono-dark">Direct lines</h2>
          <ul class="mt-3 divide-y divide-dashed divide-charcoal/15">
            {management.map((p) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <div class="min-w-0">
                  <p class="truncate font-display font-semibold text-[15.5px] tracking-[-0.02em] text-charcoal">{p.data.name}</p>
                  <p class="label-mono-dark">{p.data.role}</p>
                </div>
                <a href={`tel:+88${p.data.phone!.replace(/\s/g, '')}`} class="shrink-0 font-mono text-[12px] tnum text-charcoal hover:text-wine">{p.data.phone}</a>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-5 overflow-hidden rounded-[12px] bg-white/70">
          <iframe src={mapSrc} title="Map showing Paltan Tower, 87 Purana Paltan Line, Dhaka" width="100%" height="260" style="border:0" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          <p class="px-5 py-3 text-[11.5px] text-ink-2">Paltan Tower is on Purana Paltan Line, a short walk from Paltan Circle and the Baitul Mukarram gate.</p>
        </div>
      </div>
    </div>
  </section>
</Base>
