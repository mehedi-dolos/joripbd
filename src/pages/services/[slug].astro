---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((s) => ({ params: { slug: s.id }, props: { service: s } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const others = (await getCollection('services')).filter((s) => s.id !== service.id).sort((a, b) => a.data.order - b.data.order);
const d = service.data;
---
<Base title={d.title} description={d.promise}>
  <PageHeader eyebrow={`Service ${String(d.order).padStart(2, '0')} / 04`} title={d.title} intro={d.promise} image={{ src: d.heroImage ?? `/images/hero-${service.id}.jpg`, alt: d.heroAlt ?? d.title }} />

  <section class="dotgrid bg-paper">
    <div class="container-site grid gap-12 py-16 md:grid-cols-12 md:py-24">
      <article class="md:col-span-8">
        <div class="prose-jop text-[15.5px] text-ink-2"><Content /></div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2">
          <div class="rounded-[12px] bg-white/70 p-7">
            <h2 class="label-mono-dark">What it covers</h2>
            <ul class="mt-4 space-y-2 text-[13px] text-ink-2">
              {d.covers.map((c) => <li class="flex gap-2.5"><span class="mt-[9.5px] h-px w-3 shrink-0 bg-wine"></span><span class={c.startsWith('[') ? 'italic text-muted' : ''}>{c}</span></li>)}
            </ul>
          </div>
          <div class="rounded-[12px] bg-white/70 p-7">
            <h2 class="label-mono-dark">What you receive</h2>
            <ul class="mt-4 space-y-2 text-[13px] text-ink-2">
              {d.receive.map((r) => <li class="flex gap-2.5"><Icon name="check" size={14} class="mt-[3.5px] shrink-0 text-wine" />{r}</li>)}
            </ul>
          </div>
        </div>

        {d.steps && (
          <div class="mt-14">
            <h2 class="display-3 text-charcoal">How it runs</h2>
            <ol class="mt-6 rounded-[12px] border border-charcoal/20">
              {d.steps.map((s, i) => (
                <li class={`grid gap-2 px-6 py-5 sm:grid-cols-12 sm:gap-6 ${i > 0 ? 'border-t border-dashed border-charcoal/20' : ''}`}>
                  <span class="label-mono-dark sm:col-span-2">Step {String(i + 1).padStart(2, '0')}</span>
                  <h3 class="font-display text-[20px] leading-[1.1] tracking-[-0.05em] text-charcoal sm:col-span-3">{s.title}</h3>
                  <p class="text-[12.5px] leading-[1.6] text-ink-2 sm:col-span-7">{s.text}</p>
                </li>
              ))}
            </ol>
          </div>
        )}

        {d.turnaround && (
          <p class="mt-8 rounded-[12px] border-l-4 border-wine bg-white/70 px-5 py-4 text-[12.5px] leading-[1.6] text-ink-2"><strong class="text-charcoal">Turnaround.</strong> {d.turnaround}</p>
        )}
      </article>

      <aside class="md:col-span-4">
        <div class="sticky top-24 flex flex-col gap-4">
          <div class="folder hatch mt-4 bg-wine p-7 text-white">
            <p class="label-mono text-white/60">Appoint us</p>
            <h2 class="mt-3 font-display text-[22px] leading-[1.1] tracking-[-0.05em] text-white">Request {d.title.toLowerCase()}</h2>
            <p class="mt-3 text-[12.5px] leading-[1.55] text-white/80">Send the appointment letter or a short description. We confirm the surveyor and the visit date within one working day.</p>
            <a href="/contact/" class="btn-paper mt-5 w-full">Request a service <Icon name="arrow-right" size={14} /></a>
            <a href={site.phoneHref} class="mt-3 flex items-center justify-center gap-2 font-mono text-[12px] tnum text-white/85 hover:text-white"><Icon name="phone" size={13} />{site.phone}</a>
          </div>
          <div class="rounded-[12px] bg-white/70 p-6">
            <h2 class="label-mono-dark">Appointed by</h2>
            <ul class="mt-3 space-y-1.5 text-[12.5px] text-ink-2">
              {d.appointedBy.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="rounded-[12px] bg-white/70 p-6">
            <h2 class="label-mono-dark">Other services</h2>
            <ul class="mt-3 divide-y divide-dashed divide-charcoal/15">
              {others.map((o) => <li><a href={`/services/${o.id}/`} class="flex items-center justify-between py-2.5 font-display text-[17.5px] tracking-[-0.05em] text-charcoal hover:text-wine">{o.data.title} <Icon name="arrow-right" size={12} /></a></li>)}
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
